<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <!-- ePays generates a unique URL for each payment request -->
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]"/>
            </t>
        </form>
    </template>

    <!-- The payment form shows at most four logos per payment method. The single "ePays" option
         stands for every method of the ePays page, so it shows all of its logos. -->
    <template id="method_form" inherit_id="payment.method_form">
        <xpath expr="//t[@t-call='payment.form_logo']" position="attributes">
            <attribute name="t-if">pm_index &lt; 4 or pm_sudo.code == 'epays'</attribute>
        </xpath>
    </template>

    <!-- A cancelled or declined payment with the gateway can still take the money: that customer
         waits for the bank's answer, and must not read that the payment failed. -->
    <template id="state_header" inherit_id="payment.state_header">
        <xpath expr="//t[@t-if='is_html_empty(status_message)']" position="before">
            <t t-set="epays_waits_for_bank"
               t-value="tx.provider_code == 'epays' and tx._epays_waits_for_bank()"/>
            <t t-if="epays_waits_for_bank">
                <t t-set="alert_style" t-value="'info'"/>
                <t t-set="status_heading" t-value="waiting_heading"/>
                <t t-set="status_message">
                    <p>Your bank is still confirming this payment.</p>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-out='tx.state_message']" position="attributes">
            <attribute name="t-if">tx.state_message and not epays_waits_for_bank</attribute>
        </xpath>
    </template>

</odoo>
