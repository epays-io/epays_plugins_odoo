#. module: payment_epays
#: model_terms:ir.ui.view,arch_db:payment_epays.payment_provider_form
msgid ""
"<strong>Data shared with ePays.</strong>\n"
"                        ePays is an external, paid service. For each payment, Odoo sends ePays the\n"
"                        amount, the currency, the sales order and invoice numbers, and the\n"
"                        database and website names with the Odoo and addon versions.\n"
"                        When \"Send Customer Details\" is on, it also sends the customer's name,\n"
"                        email, phone and address. ePays returns the payment result with masked card\n"
"                        and authorisation details, which are stored on the transaction."
msgstr ""

